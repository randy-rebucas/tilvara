# Copy to .env (gitignored). Dev values only — production secrets come from the secret manager.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (JSON logs to stdout)
LOG_LEVEL=info

# Runtime connection (RLS-enforced role)
DATABASE_URL=postgres://onepos_app:onepos_app_dev@127.0.0.1:55460/onepos
# Migration connection (schema owner)
DATABASE_MIGRATOR_URL=postgres://onepos_migrator:onepos_migrator_dev@127.0.0.1:55460/onepos

# Integration tests
TEST_DATABASE_URL=postgres://onepos_app:onepos_app_dev@127.0.0.1:55460/onepos_test
TEST_DATABASE_MIGRATOR_URL=postgres://onepos_migrator:onepos_migrator_dev@127.0.0.1:55460/onepos_test

REDIS_URL=redis://127.0.0.1:56400/0

API_PORT=4320
ADMIN_WEB_PORT=3320

# At least 32 random bytes in production
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900

# Card/QR payments. PAYMENT_PROVIDER=dev is the deterministic simulator (refused in production).
PAYMENT_PROVIDER=dev
# PayMongo sandbox keys (Dashboard → Developers, test mode). Test keys only outside production.
# Never commit real values; .env is gitignored.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Signing secret of the webhook endpoint (whsk_…), shown when the webhook is created
PAYMONGO_WEBHOOK_SECRET=
