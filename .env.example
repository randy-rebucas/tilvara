# Copy to .env (gitignored). Dev values only — production secrets come from the secret manager.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (JSON logs to stdout)
LOG_LEVEL=info

# Runtime connection (RLS-enforced role)
DATABASE_URL=postgres://onepos_app:onepos_app_dev@127.0.0.1:55460/onepos
# Migration connection (schema owner)
DATABASE_MIGRATOR_URL=postgres://onepos_migrator:onepos_migrator_dev@127.0.0.1:55460/onepos

# Integration tests
TEST_DATABASE_URL=postgres://onepos_app:onepos_app_dev@127.0.0.1:55460/onepos_test
# The outbox worker's own login (ADR-0016): it may only claim/complete events and read what its
# handlers need. Existing volumes: create the role with infra/docker/postgres/upgrade/2026-10-17-worker-role.sql.
WORKER_DATABASE_URL=postgres://onepos_worker:onepos_worker_dev@127.0.0.1:55460/onepos
TEST_WORKER_DATABASE_URL=postgres://onepos_worker:onepos_worker_dev@127.0.0.1:55460/onepos_test
TEST_DATABASE_MIGRATOR_URL=postgres://onepos_migrator:onepos_migrator_dev@127.0.0.1:55460/onepos_test

# Backups and the restore drill (ADR-0016 slice 4, docs/operations/backup-restore.md).
# The backup login reads every tenant (BYPASSRLS): ops credentials only, never on an app host.
# Existing volumes: create it with infra/docker/postgres/upgrade/2026-10-17-backup-role.sql.
BACKUP_DATABASE_URL=postgres://onepos_backup:onepos_backup_dev@127.0.0.1:55460/onepos
TEST_BACKUP_DATABASE_URL=postgres://onepos_backup:onepos_backup_dev@127.0.0.1:55460/onepos_test
# Relative paths are taken from the repository root (gitignored).
BACKUP_DIR=.backups
BACKUP_KEEP_DAYS=30
# Public key(s) the backups are encrypted to (`pnpm --filter @1pos/database backup keygen --out <file>`).
BACKUP_AGE_RECIPIENT=
# Drill only: the secret key file and a superuser login on the cluster the drill restores into.
BACKUP_AGE_IDENTITY_FILE=.backups/keys/dev-drill.agekey
DRILL_ADMIN_URL=postgres://onepos_owner:onepos_owner_dev@127.0.0.1:55460/postgres
# Run pg_dump/pg_restore inside this container (dev: no local Postgres tools). Empty = from PATH.
PG_TOOLS_DOCKER=onepos-postgres-1

REDIS_URL=redis://127.0.0.1:56400/0

API_PORT=4320
# 0.0.0.0 inside a container behind the edge proxy
API_HOST=127.0.0.1

# Internal Prometheus metrics (ADR-0016): GET /metrics on its own listener, never the public one.
# Keep METRICS_HOST private (127.0.0.1, or the pod/VPC address the scraper reaches). 0 = off.
METRICS_HOST=127.0.0.1
# Bearer token Prometheus sends to /metrics (API and worker); required in production when METRICS_HOST is not loopback.
METRICS_TOKEN=
API_METRICS_PORT=4329
WORKER_METRICS_PORT=4339

# At least 32 random bytes in production
JWT_ACCESS_SECRET=dev-only-change-me-dev-only-change-me
JWT_ACCESS_TTL_SECONDS=900

# Two-step sign-in (ADR-0016). The key encrypts authenticator secrets at rest: 32 random bytes,
# base64 (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Required in production; left empty here, dev derives one from JWT_ACCESS_SECRET.
# To change it, keep the old one in MFA_ENCRYPTION_KEY_PREVIOUS and run `pnpm --filter @1pos/api mfa-rekey`
# (docs/operations/security-incident.md 2.5.1); without that, existing enrolments become unreadable.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_PREVIOUS=
# Days a privileged member (owner/admin/accountant…) may work before two-step sign-in is required.
MFA_GRACE_DAYS=7

# Card/QR payments. PAYMENT_PROVIDER=dev is the deterministic simulator (refused in production).
PAYMENT_PROVIDER=dev
# PayMongo sandbox keys (Dashboard → Developers, test mode). Test keys only outside production.
# Never commit real values; .env is gitignored.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Signing secret of the webhook endpoint (whsk_…), shown when the webhook is created
PAYMONGO_WEBHOOK_SECRET=

# Outbound webhooks (ADR-0019). The API and the worker sign with the same key; required (and not this placeholder) in production.
WEBHOOK_SIGNING_KEY=dev-only-webhook-signing-key-change-me-0000
# Development only: lets an endpoint use http or a private address (a receiver on this machine).
WEBHOOK_ALLOW_INSECURE=true

# Admin web server only: the API it proxies (the /v1 is required) and the till the overview's
# "First sale" button opens (unset = the sales reports).
# ONEPOS_API_URL=http://127.0.0.1:4320/v1
# ONEPOS_POS_URL=http://127.0.0.1:3330
# A business's own address <slug>.<ONEPOS_SHOP_DOMAIN> (session 40): needs both, the admin URL on another host
# than the shops (wildcard DNS and certificate for *.<domain> pointing at the admin). Off when either is unset.
# ONEPOS_SHOP_DOMAIN=tilvara.ph
# ONEPOS_ADMIN_URL=https://app.tilvara.ph
# The admin's server sends each visitor's address to the API with this secret (session 40), so per-IP limits count
# visitors, not the admin server. Same value as the API's BFF_SHARED_SECRET (32+ characters; required in production).
# ONEPOS_TRUST_PROXY_HOPS is the number of proxies in front of the admin (a load balancer: 1).
# BFF_SHARED_SECRET=
# ONEPOS_BFF_SECRET=
# ONEPOS_TRUST_PROXY_HOPS=1
