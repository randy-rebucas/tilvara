{
  "name": "1pos",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint apps packages",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @1pos/database db:generate",
    "db:migrate": "pnpm --filter @1pos/database db:migrate",
    "dev:api": "pnpm --filter @1pos/api dev",
    "dev:web": "pnpm --filter @1pos/admin-web dev",
    "test:e2e:web": "node apps/admin-web/e2e/smoke.mjs",
    "test:e2e:web:customers": "node apps/admin-web/e2e/customers.mjs",
    "test:e2e:web:analysis": "node apps/admin-web/e2e/analysis.mjs",
    "test:e2e:web:inventory-extras": "node apps/admin-web/e2e/inventory-extras.mjs",
    "test:e2e:web:grocery": "node apps/admin-web/e2e/grocery.mjs",
    "test:e2e:web:retail": "node apps/admin-web/e2e/retail.mjs",
    "test:e2e:web:salon": "node apps/admin-web/e2e/salon.mjs",
    "test:e2e:web:lodging": "node apps/admin-web/e2e/lodging.mjs",
    "test:e2e:web:laundry": "node apps/admin-web/e2e/laundry.mjs",
    "test:e2e:web:pharmacy": "node apps/admin-web/e2e/pharmacy.mjs",
    "test:e2e:web:integrations": "node apps/admin-web/e2e/integrations.mjs",
    "dev:pos": "pnpm --filter @1pos/pos-desktop dev",
    "test:e2e:pos": "node apps/pos-desktop/e2e/smoke.mjs",
    "test:e2e:pos:controls": "node apps/pos-desktop/e2e/counter-controls.mjs",
    "test:e2e:tables": "node apps/pos-desktop/e2e/tables.mjs",
    "test:e2e:kitchen": "node apps/pos-desktop/e2e/kitchen.mjs",
    "test:e2e:floor": "node apps/pos-desktop/e2e/floor.mjs",
    "test:e2e:web:restaurant": "node apps/admin-web/e2e/restaurant.mjs",
    "test:e2e:web:reports": "node apps/admin-web/e2e/reports.mjs",
    "test:e2e:service": "node apps/pos-desktop/e2e/service.mjs",
    "test:e2e:web:offline": "node apps/admin-web/e2e/offline.mjs",
    "test:e2e:desktop": "node apps/pos-desktop/e2e/desktop.mjs",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:bundles": "node scripts/security/scan-bundles.mjs --self-test && node scripts/security/scan-bundles.mjs",
    "security:pages": "node scripts/security/scan-bundles.mjs --live",
    "test:e2e:web:security": "node apps/admin-web/e2e/security.mjs",
    "test:e2e:pos:mfa": "node apps/pos-desktop/e2e/mfa.mjs",
    "test:e2e:web:backoffice": "node apps/admin-web/e2e/backoffice.mjs",
    "test:e2e:web:onboarding": "node apps/admin-web/e2e/onboarding.mjs",
    "test:e2e:web:account": "node apps/admin-web/e2e/account.mjs",
    "test:e2e:web:guide": "node apps/admin-web/e2e/guide.mjs",
    "test:e2e:web:drawers": "node apps/admin-web/e2e/drawers.mjs",
    "test:e2e:web:stock": "node apps/admin-web/e2e/stock.mjs",
    "test:e2e:web:payables": "node apps/admin-web/e2e/payables.mjs",
    "test:e2e:pos:extras": "node apps/pos-desktop/e2e/counter-extras.mjs",
    "test:e2e:pos:counter": "node apps/pos-desktop/e2e/counter-service.mjs",
    "test:e2e:pos:retail": "node apps/pos-desktop/e2e/retail.mjs",
    "test:e2e:pos:salon": "node apps/pos-desktop/e2e/salon.mjs",
    "test:e2e:pos:lodging": "node apps/pos-desktop/e2e/lodging.mjs",
    "test:e2e:pos:laundry": "node apps/pos-desktop/e2e/laundry.mjs",
    "test:e2e:pos:pharmacy": "node apps/pos-desktop/e2e/pharmacy.mjs",
    "backup": "pnpm --filter @1pos/database backup",
    "test:db:reset": "pnpm --filter @1pos/database build && pnpm --filter @1pos/database test-db-reset",
    "drill:restore": "node --env-file-if-exists=.env infra/backup/drill-restore.mjs",
    "load:seed": "pnpm --filter @1pos/api exec tsx test/load/seed.ts",
    "load:run": "pnpm --filter @1pos/api exec tsx test/load/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.4.2",
    "turbo": "^2.11.8",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
