{
  "name": "@1pos/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env dist/migrate.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "support": "node --env-file=../../.env dist/support-cli.js",
    "test-db-reset": "node --env-file=../../.env dist/test-db-reset.js",
    "backup": "node --env-file-if-exists=../../.env dist/backup-cli.js"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
